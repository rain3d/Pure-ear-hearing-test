<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette (Medical Instrument Dark Aesthetics) -->
    <Color x:Key="BgDarkColor">#0A0E1A</Color>
    <Color x:Key="SurfaceColor">#131B2E</Color>
    <Color x:Key="SurfaceHoverColor">#1A253E</Color>
    <Color x:Key="CardBorderColor">#22304E</Color>
    
    <Color x:Key="PrimaryAccentColor">#00D2D3</Color>
    <Color x:Key="PrimaryAccentDarkColor">#01A3A4</Color>
    
    <Color x:Key="LeftEarColor">#2563EB</Color>
    <Color x:Key="LeftEarGlowColor">#3B82F6</Color>
    
    <Color x:Key="RightEarColor">#DC2626</Color>
    <Color x:Key="RightEarGlowColor">#EF4444</Color>

    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="DangerColor">#E11D48</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>

    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}"/>
    <SolidColorBrush x:Key="PrimaryAccentDarkBrush" Color="{StaticResource PrimaryAccentDarkColor}"/>

    <SolidColorBrush x:Key="LeftEarBrush" Color="{StaticResource LeftEarColor}"/>
    <SolidColorBrush x:Key="RightEarBrush" Color="{StaticResource RightEarColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <!-- Convenience Aliases -->
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource PrimaryAccentColor}"/>

