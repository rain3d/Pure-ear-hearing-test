<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- App & Brand -->
    <sys:String x:Key="Str_AppTitle">專業純音聽力測驗系統</sys:String>
    <sys:String x:Key="Str_AppSubtitle">Pure-Tone Audiometry Clinical &amp; Research Platform</sys:String>
    <sys:String x:Key="Str_AppWindowTitle">專業純音聽力測驗系統 (Pure-Tone Audiometry) v1.0.0 - [研究/個人追蹤版 - 非醫療診斷]</sys:String>
    <sys:String x:Key="Str_PatientWindowTitle">純音聽力測驗 - 受測者專用視窗</sys:String>
    <sys:String x:Key="Str_LanguageLabel">介面語系</sys:String>

    <!-- Home View -->
    <sys:String x:Key="Str_CalibrationBadgeValid">校正狀態：有效 (已驗證)</sys:String>
    <sys:String x:Key="Str_CalibrationBadgeInvalid">校正狀態：未校正 (研究模式)</sys:String>
    <sys:String x:Key="Str_SafeInterlockBadge">安全互鎖：0~50 dB HL (已鎖定)</sys:String>
    <sys:String x:Key="Str_HardwareStatusTitle">系統環境與電聲鏈配置狀態</sys:String>
    <sys:String x:Key="Str_HardwareStatusDesc">音訊驅動：WASAPI Exclusive (48 kHz / 24-bit)  |  耳機指紋：封閉式監聽耳機 (未校正研究模式)  |  非醫療用途聲明生效中</sys:String>
    <sys:String x:Key="Str_SimulatedPatientCheck">啟用虛擬受測者自動應答 (模擬演練模式)</sys:String>

    <sys:String x:Key="Str_StartSixFreqTest">開始標準六頻測驗</sys:String>
    <sys:String x:Key="Str_StartSixFreqDesc">250, 500, 1000, 2000, 4000, 8000 Hz 左右耳自動尋閾流程</sys:String>
    <sys:String x:Key="Str_StartQuickVerification">個人複測預設 (LeftEarVerification)</sys:String>
    <sys:String x:Key="Str_StartQuickVerificationDesc">載入左耳歷史預估值對照 (500Hz:20dB, 1000Hz:40dB, 2000Hz:30dB)</sys:String>

    <sys:String x:Key="Str_OpenPatientScreen">開啟受測者獨立視窗 (副螢幕)</sys:String>
    <sys:String x:Key="Str_OpenPatientScreenDesc">雙螢幕盲測模式，隱藏分貝與頻率數值</sys:String>
    <sys:String x:Key="Str_OpenCalibration">設備與聲學校正管理</sys:String>
    <sys:String x:Key="Str_OpenCalibrationDesc">硬體指紋綁定、RETSPL 校正與防竄改驗證</sys:String>
    <sys:String x:Key="Str_OpenHistory">歷史測驗數據紀錄</sys:String>
    <sys:String x:Key="Str_OpenHistoryDesc">檢視本機 SQLite 儲存之歷史聽力圖與報告</sys:String>

    <sys:String x:Key="Str_SystemFunctions">系統功能專區</sys:String>
    <sys:String x:Key="Str_CardStartTest">開始測驗</sys:String>
    <sys:String x:Key="Str_CardStartTestDesc">進入操作者即時控制台</sys:String>
    <sys:String x:Key="Str_CardPatientView">受測者畫面</sys:String>
    <sys:String x:Key="Str_CardPatientViewDesc">切換至受測者專用無干擾介面</sys:String>
    <sys:String x:Key="Str_CardHistory">歷史紀錄</sys:String>
    <sys:String x:Key="Str_CardHistoryDesc">查詢過去測驗聽力圖與報告</sys:String>
    <sys:String x:Key="Str_CardCalib">校正狀態</sys:String>
