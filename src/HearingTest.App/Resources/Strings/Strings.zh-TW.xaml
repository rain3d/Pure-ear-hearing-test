    <sys:String x:Key="Str_CardAudio">音訊裝置</sys:String>
    <sys:String x:Key="Str_CardAudioDesc">WASAPI 輸出與左右聲道檢測</sys:String>
    <sys:String x:Key="Str_CardExport">報告匯出</sys:String>
    <sys:String x:Key="Str_CardExportDesc">JSON / CSV / 匿名研究資料</sys:String>
    <sys:String x:Key="Str_CardHome">系統首頁</sys:String>
    <sys:String x:Key="Str_CardHomeDesc">返回儀表板主控台</sys:String>
    <sys:String x:Key="Str_CardSpecs">規格與說明</sys:String>
    <sys:String x:Key="Str_CardSpecsDesc">法規界線與操作標準規範</sys:String>

    <sys:String x:Key="Str_PatientInfoSection">受測者基本資料與測試設定</sys:String>
    <sys:String x:Key="Str_PatientId">受測者編號 (ID)</sys:String>
    <sys:String x:Key="Str_PatientAge">年齡 (Age)</sys:String>
    <sys:String x:Key="Str_PatientGender">性別 (Gender)</sys:String>
    <sys:String x:Key="Str_GenderMale">男 (Male)</sys:String>
    <sys:String x:Key="Str_GenderFemale">女 (Female)</sys:String>
    <sys:String x:Key="Str_GenderOther">未填 (Unspecified)</sys:String>
    <sys:String x:Key="Str_PatientNotes">臨床備註 (Notes)</sys:String>
    <sys:String x:Key="Str_PatientNotesPlaceholder">可填寫受測環境、主訴耳鳴或相關病史...</sys:String>

    <sys:String x:Key="Str_ProtocolGuideTitle">ISO 8253-1 / ASHA 標準聽閾搜尋規範</sys:String>
    <sys:String x:Key="Str_ProtocolGuide1">採用標準 10-down / 5-up 階梯法；於上升序列累計 2 次反應即確立聽閾。</sys:String>
    <sys:String x:Key="Str_ProtocolGuide2">測試順序：1000 Hz → 2000 Hz → 4000 Hz → 8000 Hz → 1000 Hz (複驗) → 500 Hz → 250 Hz。</sys:String>
    <sys:String x:Key="Str_ProtocolGuide3">白名單上限為 50 dB HL，達到 50 dB HL 兩次無反應自動記錄為 NR @ 50 dB HL。</sys:String>
    <sys:String x:Key="Str_ProtocolGuide4">隨機插入對照靜音 (Catch Trial) 偵測假陽性率，確保測試結果高可靠度。</sys:String>

    <!-- Operator Test View -->
    <sys:String x:Key="Str_ReturnHome">返回首頁</sys:String>
    <sys:String x:Key="Str_OperatorConsoleTitle">操作者即時測驗控制台</sys:String>
    <sys:String x:Key="Str_OperatorConsoleSub"> (ISO 8253-1 自動 10-down / 5-up 尋閾)</sys:String>
    <sys:String x:Key="Str_TestCompleteSummary">🎉 測驗已完成 (查看總結)</sys:String>
    <sys:String x:Key="Str_ResetUnlock">重設解鎖</sys:String>
    <sys:String x:Key="Str_EmergencyStopButton">🛑 全域緊急停止 (Esc)</sys:String>

