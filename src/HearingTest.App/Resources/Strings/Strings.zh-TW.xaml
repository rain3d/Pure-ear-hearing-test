    <sys:String x:Key="Str_ActiveFrequency">當前頻率 (Freq)</sys:String>
    <sys:String x:Key="Str_ActiveLevel">刺激音量 (Level)</sys:String>
    <sys:String x:Key="Str_ActiveStatus">狀態 (Status)</sys:String>
    <sys:String x:Key="Str_CatchTrialLabel">對照靜音 (Catch Trial)</sys:String>

    <sys:String x:Key="Str_MaskingDrawerTitle">對側窄頻遮蔽控制 (Contralateral Masking)</sys:String>
    <sys:String x:Key="Str_MaskingEnable">啟用對側窄頻遮蔽</sys:String>
    <sys:String x:Key="Str_MaskingLevel">遮蔽強度 (Level)</sys:String>
    <sys:String x:Key="Str_ApplyAutoMasking">套用推薦遮蔽值</sys:String>
    <sys:String x:Key="Str_MaskingWarning">跨耳衰減提示：刺激量與對側耳差值 ≥ 40 dB，建議啟用遮蔽。</sys:String>

    <sys:String x:Key="Str_StimulusPlay">播放刺激 (F5)</sys:String>
    <sys:String x:Key="Str_PatientHeard">受測者已聽見 (Space)</sys:String>
    <sys:String x:Key="Str_AutoAdvance">自動推進頻率 (Auto-Advance)</sys:String>
    <sys:String x:Key="Str_RetestCurrent">當前頻率重新測試</sys:String>
    <sys:String x:Key="Str_RollbackStep">回退一階 (Rollback)</sys:String>
    <sys:String x:Key="Str_AbortTest">中止測驗並返回</sys:String>

    <sys:String x:Key="Str_TimelineTitle">刺激事件時間序列 (Real-time Timeline)</sys:String>
    <sys:String x:Key="Str_ColTime">時間</sys:String>
