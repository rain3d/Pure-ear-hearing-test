    <sys:String x:Key="Str_AudiogramDbRelAxis">相对强度 (dBFS/Rel)</sys:String>
    <sys:String x:Key="Str_AudiogramWatermark">非医疗诊断 / 未校准研究模式</sys:String>
    <sys:String x:Key="Str_GradeNormal">正常听力 (Normal)</sys:String>
    <sys:String x:Key="Str_GradeMild">轻度听损 (Mild)</sys:String>
