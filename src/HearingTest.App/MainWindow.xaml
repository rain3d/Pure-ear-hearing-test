<Window x:Class="HearingTest.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HearingTest.App.Views"
        xmlns:vm="clr-namespace:HearingTest.App.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource Str_AppWindowTitle}" 
        Height="820" Width="1360"
        MinWidth="1280" MinHeight="720"
        Icon="pack://application:,,,/Resources/app.ico"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding HeardResponseCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding EmergencyStopCommand}"/>
        <KeyBinding Key="F5" Command="{Binding NextStimulusCommand}"/>
    </Window.InputBindings>

    <Grid>
        <!-- Home View -->
        <views:HomeView Visibility="{Binding CurrentViewName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Home}"/>

        <!-- Operator Test View -->
        <views:OperatorTestView Visibility="{Binding CurrentViewName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OperatorTest}"/>

        <!-- Patient Screen View -->
        <views:PatientView Visibility="{Binding CurrentViewName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=PatientScreen}"/>

        <!-- History View -->
        <views:HistoryView Visibility="{Binding CurrentViewName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=History}"/>

        <!-- Calibration View -->
        <views:CalibrationView Visibility="{Binding CurrentViewName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Calibration}"/>

        <!-- Full-Page Mandatory Startup Disclaimer Modal Overlay -->
        <Grid Background="#F0090D16"
              Panel.ZIndex="1000"
              Visibility="{Binding IsDisclaimerAccepted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Border Width="920" MaxHeight="720"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="2"
                    CornerRadius="16"
                    Padding="36,28"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header with Title & Language Selector -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Str_DisclaimerModalTitle}" 
                                       FontSize="22" FontWeight="Bold" 
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{DynamicResource Str_DisclaimerModalSubtitle}" 
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" 
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Language Selector in Modal -->
                        <Border Grid.Column="1" VerticalAlignment="Top"
                                Background="{StaticResource SurfaceLightBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐 " FontSize="13" VerticalAlignment="Center" Margin="2,0,2,0"/>
                                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          DisplayMemberPath="NativeName"
                                          MinWidth="110" Height="30"
                                          Background="Transparent" BorderThickness="0"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Scrollable Disclaimer Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24">
                        <StackPanel Margin="0,0,12,0">
                            <!-- Section 1: Hearing Protection & Volume Warning -->
                            <Border Background="#1A2D1A05" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_DisclaimerSectionVolumeTitle}" 
                                               FontSize="15" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Str_DisclaimerSectionVolumeContent}" 
                                               FontSize="13" Foreground="#FDE68A" LineHeight="20" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Non-Medical & Legal Disclaimer -->
                            <Border Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_DisclaimerSectionLegalTitle}" 
                                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Str_DisclaimerSectionLegalContent}" 
                                               FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="20" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Open Source & Non-Commercial License -->
                            <Border Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_DisclaimerSectionLicenseTitle}" 
                                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Str_DisclaimerSectionLicenseContent}" 
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons: Agree vs Disagree -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Disagree & Exit Button -->
                        <Button Grid.Column="0"
                                Content="{DynamicResource Str_DisclaimerBtnDecline}"
                                Command="{Binding DeclineDisclaimerCommand}"
                                Height="46" Padding="20,0"
                                Background="#2A1010" BorderBrush="#EF4444" BorderThickness="1.5"
                                Foreground="#F87171" FontSize="14" FontWeight="Bold"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Agree & Continue Button -->
                        <Button Grid.Column="2"
                                Content="{DynamicResource Str_DisclaimerBtnAgree}"
                                Command="{Binding AcceptDisclaimerCommand}"
                                Height="46" Padding="28,0"
                                Background="{StaticResource AccentBrush}" BorderThickness="0"
                                Foreground="White" FontSize="15" FontWeight="Bold"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
