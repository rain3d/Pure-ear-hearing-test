<UserControl x:Class="HearingTest.App.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="1200">
            <!-- Top Header & Action Buttons -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource InteractiveCardStyle}" Padding="10,6" 
                            Command="{Binding NavigateCommand}" CommandParameter="Home" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHome}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str_ReturnHome}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{DynamicResource Str_CalibrationTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Buttons & Language Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector Pill -->
                    <ComboBox Style="{StaticResource LanguageComboBoxStyle}"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource Str_ImportSignedProfile}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Command="{Binding ImportCalibrationFileCommand}"/>
                    <Button Content="{DynamicResource Str_GenerateLocalProfile}" Style="{StaticResource PrimaryButtonStyle}" Background="#3B82F6" Margin="0,0,10,0" Command="{Binding GenerateSampleCalibrationCommand}"/>
                    <Button Content="{DynamicResource Str_ResetUnlock}" Style="{StaticResource PrimaryButtonStyle}" Background="#475569" Command="{Binding UnloadCalibrationCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Calibration Status Notice Card -->
            <Border Background="#1E293B" BorderBrush="{Binding CalibrationBadgeBrush}" BorderThickness="1.5" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource IconShield}" Fill="{Binding CalibrationBadgeBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CalibrationBadgeText}" FontSize="18" FontWeight="Bold" Foreground="{Binding CalibrationBadgeBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CalibrationStatusDescription}" 
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="重要規範：一般電腦與市售耳機未經人工耳／耦合器（IEC 60318-1）逐頻率量測 RETSPL 前，數位強度（dBFS）無法宣稱等同醫院臨床標準聲壓級（dB HL）。本工具在缺少有效簽章校正檔時，UI 全程鎖定為【未校正研究相對刻度】。"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>

                    <!-- Calibration Expiry & Lab Info Box -->
                    <Border Grid.Column="1" Background="#0F172A" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel MinWidth="220">
                            <TextBlock Text="校驗實驗室：" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CalibrationLabInfo}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <TextBlock Text="效期狀態：" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CalibrationExpiryInfo}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding CalibrationBadgeBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Smartphone Decibel Meter Quick Calibrator Card -->
            <Border Style="{StaticResource CardBorderStyle}" Background="#0B132B" BorderBrush="#3B82F6" BorderThickness="1.5" Padding="22" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1D4ED8" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                <TextBlock Text="📱 推薦快校" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock Text="手機分貝計 / 噪音計簡易校準小幫手 (Smartphone SLM Calibrator)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Border Background="#1E293B" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right">
                            <TextBlock Text="ISO 8253-1 臨床 1000 Hz 錨定基準法" FontSize="11" Foreground="#93C5FD" FontWeight="SemiBold"/>
                        </Border>
                    </DockPanel>

                    <!-- 3-Step Guided Layout -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Step 1: Prep -->
                        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="步驟 1：固定音量與密合" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                <TextBlock Text="1. 將 Windows 系統總音量固定在 50% 或 60%，校正後請勿更動。" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="16"/>
                                <TextBlock Text="2. 手機開啟分貝計 App（如 NIOSH SLM 或 Sound Meter）。" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="16"/>
                                <TextBlock Text="3. 將耳機單體發聲孔【緊密按壓貼平】在手機收音孔上，四周不可漏風。" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 2: Play Reference Tone -->
                        <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="步驟 2：播放 1000 Hz 參考音" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                
                                <TextBlock Text="測試耳機單體：" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}" SelectedIndex="{Binding CalibratorSelectedEarIndex}" Height="32" Margin="0,0,0,10">
                                    <ComboBoxItem Style="{StaticResource DarkComboBoxItemStyle}" Content="左耳單體 (Left Channel)"/>
                                    <ComboBoxItem Style="{StaticResource DarkComboBoxItemStyle}" Content="右耳單體 (Right Channel)"/>
                                </ComboBox>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔊 播放參考音" Style="{StaticResource PrimaryButtonStyle}" Background="#10B981" Padding="12,6" Margin="0,0,8,0"
                                            Command="{Binding PlayCalibrationToneCommand}"/>
                                    <Button Content="⏹️ 停止" Style="{StaticResource PrimaryButtonStyle}" Background="#EF4444" Padding="12,6"
                                            Command="{Binding StopCalibrationToneCommand}"/>
                                </StackPanel>

                                <TextBlock Text="強度: -20 dBFS (限時 15 秒自動停)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 3: Input & Apply -->
                        <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="步驟 3：輸入手機讀數並套用" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <Button Content="同左耳讀數" Style="{StaticResource InteractiveCardStyle}" Padding="6,2" FontSize="10" HorizontalAlignment="Right" Command="{Binding CopyLeftToRightSplCommand}"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Ear Input -->
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="左耳實測值 (dB SPL):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CalibratorMeasuredSplLeft, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#090D16" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" 
                                                 Padding="8,5" FontSize="13" FontWeight="Bold" CaretBrush="#38BDF8"/>
                                    </StackPanel>

                                    <!-- Right Ear Input -->
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="右耳實測值 (dB SPL):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CalibratorMeasuredSplRight, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#090D16" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" 
                                                 Padding="8,5" FontSize="13" FontWeight="Bold" CaretBrush="#38BDF8"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="⚡ 計算並套用手機校驗檔" Style="{StaticResource PrimaryButtonStyle}" Background="#2563EB" Height="36" 
                                        FontWeight="Bold" Command="{Binding ApplyPhoneCalibrationCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Calibrator Status Bar -->
                    <Border Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💡 校正指引：" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding CalibratorStatusText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Hardware Fingerprint Inspector Card -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="系統硬體電聲鏈與防偽指紋檢驗 (Hardware Profile &amp; Fingerprint)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="本機電腦與作業系統：" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentHardware.Computer}" Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock Grid.Row="1" Text="音訊驅動端點模式：" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentHardware.AudioDevice}" Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock Grid.Row="2" Text="指定換能器耳機：" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentHardware.HeadphoneModel}" Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock Grid.Row="3" Text="耳機左右單體序號：" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="左耳: "/><Run Text="{Binding CurrentHardware.HeadphoneSerialLeft, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  |  右耳: "/><Run Text="{Binding CurrentHardware.HeadphoneSerialRight, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Grid>

                    <!-- Fingerprint SHA-256 Hashes Comparison -->
                    <Border Background="#090D16" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="SHA-256 本機硬體電聲指紋 (即時計算)：" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding HardwareFingerprintDisplay}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,2,0,8"/>
                            <TextBlock Text="校正檔綁定硬體指紋 (數位簽章校驗)：" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CalibrationFingerprintDisplay}" FontFamily="Consolas" FontSize="12" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Calibration Points Table -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="逐頻率電聲校正數據點 (Calibration Points)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Target_SPL = Target_HL + RETSPL  |  Output_dBFS = Reference_dBFS + Gain" 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListView ItemsSource="{Binding CalibrationPoints}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="頻率 (Hz)" DisplayMemberBinding="{Binding FrequencyHz}" Width="90"/>
                                <GridViewColumn Header="耳別" DisplayMemberBinding="{Binding Ear}" Width="80"/>
                                <GridViewColumn Header="數位參考值 (dBFS)" DisplayMemberBinding="{Binding ReferenceDbfs, StringFormat='{}{0:F1} dBFS'}" Width="140"/>
                                <GridViewColumn Header="實測聲壓 (dB SPL)" DisplayMemberBinding="{Binding MeasuredSpl, StringFormat='{}{0:F1} dB SPL'}" Width="140"/>
                                <GridViewColumn Header="RETSPL 基準 (dB)" DisplayMemberBinding="{Binding Retspl, StringFormat='{}{0:F1} dB'}" Width="130"/>
                                <GridViewColumn Header="容許誤差 (±dB)" DisplayMemberBinding="{Binding ToleranceDb, StringFormat='{}±{0:F1} dB'}" Width="120"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
