<UserControl x:Class="HearingTest.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1200">
            <!-- Header Status Bar -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_AppTitle}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Str_AppSubtitle}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Status Pill Badges & Language Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector Pill -->
                    <ComboBox Style="{StaticResource LanguageComboBoxStyle}"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"/>

                    <!-- Calibration Badge -->
                    <Border Background="#1E293B" BorderBrush="{Binding CalibrationBadgeBrush}" BorderThickness="1.5" CornerRadius="20" Padding="14,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShield}" Fill="{Binding CalibrationBadgeBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CalibrationBadgeText}" Foreground="{Binding CalibrationBadgeBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Safe Interlock Badge -->
                    <Border Background="#1E293B" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1.5" CornerRadius="20" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWave}" Fill="{StaticResource PrimaryAccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_SafeInterlockBadge}" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Hardware & Environmental Notice Banner -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_HardwareStatusTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_HardwareStatusDesc}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>

                    <CheckBox Grid.Column="1" IsChecked="{Binding UseSimulatedPatientAutoResponse}" 
                              Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock Text="{DynamicResource Str_SimulatedPatientCheck}" Margin="4,0,0,0"/>
                    </CheckBox>
                </Grid>
            </Border>

            <!-- Quick Action Hero Cards -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Start Six-Frequency Test -->
                <Button Style="{StaticResource InteractiveCardStyle}" Command="{Binding StartSixFreqTestCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#0C3B5E" CornerRadius="12" Width="56" Height="56" Margin="0,0,16,0">
                            <Path Data="{StaticResource IconPlay}" Fill="{StaticResource PrimaryAccentBrush}" Width="24" Height="24" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_StartSixFreqTest}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str_StartSixFreqDesc}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Start Personal Quick Verification Test -->
                <Button Grid.Column="2" Style="{StaticResource InteractiveCardStyle}" Command="{Binding StartQuickVerificationCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#3B1C4B" CornerRadius="12" Width="56" Height="56" Margin="0,0,16,0">
                            <Path Data="{StaticResource IconWave}" Fill="#D946EF" Width="24" Height="24" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_StartQuickVerification}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str_StartQuickVerificationDesc}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- 8 Functional Cards Grid (Section 8.1) -->
            <TextBlock Text="{DynamicResource Str_SystemFunctions}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <UniformGrid Columns="4" Rows="2" Margin="0,0,0,16">
                <!-- 1. 開始測驗 -->
                <Button Style="{StaticResource InteractiveCardStyle}" Margin="0,0,12,12" Command="{Binding StartSixFreqTestCommand}">
                    <StackPanel>
                        <Path Data="{StaticResource IconPlay}" Fill="{StaticResource PrimaryAccentBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Str_CardStartTest}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_CardStartTestDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 2. 受測者畫面 -->
                <Button Style="{StaticResource InteractiveCardStyle}" Margin="0,0,12,12" Command="{Binding NavigateCommand}" CommandParameter="PatientScreen">
                    <StackPanel>
                        <Path Data="{StaticResource IconPatient}" Fill="#38BDF8" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Str_CardPatientView}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_CardPatientViewDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 3. 歷史紀錄 -->
                <Button Style="{StaticResource InteractiveCardStyle}" Margin="0,0,12,12" Command="{Binding NavigateCommand}" CommandParameter="History">
                    <StackPanel>
                        <Path Data="{StaticResource IconChart}" Fill="#34D399" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Str_CardHistory}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_CardHistoryDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 4. 校正狀態 -->
                <Button Style="{StaticResource InteractiveCardStyle}" Margin="0,0,0,12" Command="{Binding NavigateCommand}" CommandParameter="Calibration">
                    <StackPanel>
                        <Path Data="{StaticResource IconShield}" Fill="#FBBF24" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Str_CardCalib}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_CardCalibDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 5. 音訊裝置 -->
                <Button Style="{StaticResource InteractiveCardStyle}" Margin="0,0,12,0" Command="{Binding NavigateCommand}" CommandParameter="Calibration">
                    <StackPanel>
                        <Path Data="{StaticResource IconEar}" Fill="#A78BFA" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Str_CardAudio}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_CardAudioDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 6. 報告匯出 -->
                <Button Style="{StaticResource InteractiveCardStyle}" Margin="0,0,12,0" Command="{Binding NavigateCommand}" CommandParameter="History">
                    <StackPanel>
                        <Path Data="{StaticResource IconExport}" Fill="#F472B6" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Str_CardExport}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_CardExportDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 7. 系統設定 -->
                <Button Style="{StaticResource InteractiveCardStyle}" Margin="0,0,12,0" Command="{Binding NavigateCommand}" CommandParameter="Home">
                    <StackPanel>
                        <Path Data="{StaticResource IconHome}" Fill="#64748B" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Str_CardHome}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_CardHomeDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 8. 規格與說明 -->
                <Button Style="{StaticResource InteractiveCardStyle}" Margin="0,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="Calibration">
                    <StackPanel>
                        <Path Data="{StaticResource IconShield}" Fill="#38BDF8" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Str_CardSpecs}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_CardSpecsDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Open Source & Non-Commercial License Notice Footer -->
            <Border Margin="0,28,0,16" Padding="16,10" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="⚖️" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_LicenseFooter}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
