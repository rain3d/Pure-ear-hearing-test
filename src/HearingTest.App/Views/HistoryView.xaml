<UserControl x:Class="HearingTest.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,20">
            <Button Style="{StaticResource InteractiveCardStyle}" Padding="10,6" 
                    Command="{Binding NavigateCommand}" CommandParameter="Home" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconHome}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Str_ReturnHome}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{DynamicResource Str_HistoryTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Language Selector Pill -->
                <ComboBox Style="{StaticResource LanguageComboBoxStyle}"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"/>
                <Button Content="{DynamicResource Str_ExportJson}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Command="{Binding ExportJsonCommand}"/>
                <Button Content="{DynamicResource Str_ExportCsv}" Style="{StaticResource PrimaryButtonStyle}" Background="#3B82F6" Command="{Binding ExportCsvCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Sessions List -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="已完成或記錄之測驗場次 (SQLite 儲存)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <ListView Grid.Row="1" ItemsSource="{Binding PastSessions}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="測驗代碼" DisplayMemberBinding="{Binding Id}" Width="180"/>
                            <GridViewColumn Header="受測者代碼" DisplayMemberBinding="{Binding PatientId}" Width="160"/>
                            <GridViewColumn Header="開始時間" DisplayMemberBinding="{Binding StartedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                            <GridViewColumn Header="操作人員" DisplayMemberBinding="{Binding OperatorId}" Width="110"/>
                            <GridViewColumn Header="測驗通訊協定" DisplayMemberBinding="{Binding ProtocolVersion}" Width="140"/>
                            <GridViewColumn Header="整體可靠度" DisplayMemberBinding="{Binding OverallReliability}" Width="90"/>
                            <GridViewColumn Header="備註" DisplayMemberBinding="{Binding Notes}" Width="140"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
