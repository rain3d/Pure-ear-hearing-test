<UserControl x:Class="HearingTest.App.Views.PatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="#060911">
        <!-- Top Back button -->
        <Button Style="{StaticResource InteractiveCardStyle}" Padding="10,6" 
                Command="{Binding NavigateCommand}" CommandParameter="OperatorTest"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconHome}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                <TextBlock Text="{DynamicResource Str_ReturnHome}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
        </Button>

        <!-- Center Patient Countdown Area (5s to 1s Countdown) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsCountdownActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Big Ring with Countdown Number -->
            <Border Width="180" Height="180" CornerRadius="90" Background="#0C2540" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="4" Margin="0,0,0,28">
                <Grid>
                    <TextBlock Text="{Binding CountdownText}" FontSize="80" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock Text="{DynamicResource Str_CountdownTitle}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str_CountdownSub}" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,28"/>

            <Border Background="#0C1B33" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="12" Padding="20,14" MaxWidth="540">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconWave}" Fill="{StaticResource PrimaryAccentBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_CountdownTip}" FontSize="14" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Center Patient Attention Area (Testing in Progress) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsPatientTestingActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Calming Visual Circle Indicator -->
            <Border Width="180" Height="180" CornerRadius="90" Background="#0F172A" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="3" Margin="0,0,0,36">
                <Path Data="{StaticResource IconEar}" Fill="{StaticResource PrimaryAccentBrush}" Width="72" Height="72" Stretch="Uniform"/>
            </Border>

            <TextBlock Text="{DynamicResource Str_PatientTestingTitle}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str_PatientTestingSub}" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,32"/>

            <!-- Large Response Button for Touch or Mouse -->
            <Button Width="360" Height="100" Background="{StaticResource SuccessBrush}" Cursor="Hand" Command="{Binding HeardResponseCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#34D399" BorderThickness="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconWave}" Fill="#FFFFFF" Width="32" Height="32" Stretch="Uniform" Margin="0,0,16,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_PatientHeardBtn}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{DynamicResource Str_PatientHeardTip}" FontSize="13" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Center Patient Attention Area (Test Completed) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsTestCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Success Circle Indicator -->
            <Border Width="160" Height="160" CornerRadius="80" Background="#064E3B" BorderBrush="#10B981" BorderThickness="3.5" Margin="0,0,0,28">
                <Path Data="{StaticResource IconCheck}" Fill="#34D399" Width="72" Height="72" Stretch="Uniform"/>
            </Border>

            <TextBlock Text="{DynamicResource Str_CompletionTitle}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str_TestCompleteSummary}" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,24"/>

            <Button Style="{StaticResource PrimaryButtonStyle}" Padding="20,12" HorizontalAlignment="Center"
                    Command="{Binding NavigateCommand}" CommandParameter="OperatorTest">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconChart}" Fill="#0A0E1A" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_TestCompleteSummary}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
