<Window x:Class="HearingTest.App.Views.PatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource Str_PatientWindowTitle}"
        Width="960" Height="680"
        MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="#060911"
        Icon="pack://application:,,,/Resources/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding HeardResponseCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EmergencyStopCommand}" />
    </Window.InputBindings>

    <Grid Background="#060911">
        <!-- Background Ambient Glow -->
        <Ellipse Width="600" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Top Header Status -->
        <Border VerticalAlignment="Top" Padding="24" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconEar}" Fill="{StaticResource PrimaryAccentBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Str_PatientScreenTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="12" Padding="12,6">
                        <TextBlock Text="{DynamicResource Str_DualScreenSub}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center Patient Countdown Area (5s to 1s Countdown) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"
                    Visibility="{Binding IsCountdownActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Big Pulsing Ring with Countdown Number -->
            <Border Width="170" Height="170" CornerRadius="85" Background="#0C2540" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="4" Margin="0,0,0,24">
                <Grid>
                    <TextBlock Text="{Binding CountdownText}" FontSize="76" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock Text="{DynamicResource Str_CountdownTitle}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str_CountdownSub}" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,24"/>

            <Border Background="#0C1B33" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="12" Padding="20,14" MaxWidth="540">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconWave}" Fill="{StaticResource PrimaryAccentBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_CountdownTip}" FontSize="14" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Center Patient Interactive Area (Testing in Progress) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                    Visibility="{Binding IsPatientTestingActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Calming Visual Indicator -->
            <Border Width="160" Height="160" CornerRadius="80" Background="#0F172A" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="3" Margin="0,0,0,32">
                <Path Data="{StaticResource IconEar}" Fill="{StaticResource PrimaryAccentBrush}" Width="64" Height="64" Stretch="Uniform"/>
            </Border>

            <!-- Blind Press Warning for Patient -->
            <Border Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="12" Padding="16,10" Margin="0,0,0,24"
                    Visibility="{Binding BlindPressWarning, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" MaxWidth="640">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconStop}" Fill="#FCA5A5" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="⚠️ 提醒：目前處於靜音間隔，請勿盲目猜測！請等實際在耳機聽到蜂鳴音時再按鍵。" Foreground="#FCA5A5" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Str_PatientTestingTitle}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str_PatientTestingSub}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,32"/>

            <!-- Large Response Button -->
            <Button Width="440" Height="110" Cursor="Hand" Command="{Binding HeardResponseCommand}" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#10B981" CornerRadius="24" BorderBrush="#34D399" BorderThickness="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconWave}" Fill="#FFFFFF" Width="36" Height="36" Stretch="Uniform" Margin="0,0,16,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_PatientHeardBtn}" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{DynamicResource Str_PatientHeardTip}" FontSize="13" Foreground="#E2E8F0" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Patient Emergency Stop Button -->
            <Button Command="{Binding EmergencyStopCommand}" Margin="0,24,0,0" Padding="16,8" Cursor="Hand" Focusable="False" HorizontalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconEmergencyStop}" Fill="#EF4444" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Str_EmergencyStopButton}" Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Center Patient Completed Area (Test Completed State) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"
                    Visibility="{Binding IsTestCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Glowing Success Indicator -->
            <Border Width="150" Height="150" CornerRadius="75" Background="#064E3B" BorderBrush="#10B981" BorderThickness="3.5" Margin="0,0,0,24">
                <Path Data="{StaticResource IconCheck}" Fill="#34D399" Width="68" Height="68" Stretch="Uniform"/>
            </Border>

            <TextBlock Text="🎉 測驗已順利完成！" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="非常感謝您的耐心配合，雙耳聽力檢測程序已全數結束。" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,28"/>

            <!-- Guidance Instructions Card -->
            <Border Background="#0C1B33" BorderBrush="#1E3A8A" BorderThickness="1.5" CornerRadius="16" Padding="28,20" MinWidth="540" MaxWidth="620" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Path Data="{StaticResource IconEar}" Fill="#38BDF8" Width="22" Height="22" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="請摘下耳機，並於座位上稍候休息" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconChart}" Fill="#34D399" Width="22" Height="22" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="施測人員已取得完整聽力數據，即將為您詳細解說結果" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status Badge -->
            <Border Background="#065F46" BorderBrush="#34D399" BorderThickness="1" CornerRadius="10" Padding="18,8" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCheck}" Fill="#34D399" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="雙耳各頻率聽閾已全數確立並安全儲存至資料庫" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Bottom Helpful Hint -->
        <Border VerticalAlignment="Bottom" Padding="16" HorizontalAlignment="Center">
            <TextBlock Text="{Binding IsTestCompleted, Converter={x:Null}, TargetNullValue='受測提示：若測驗中感到任何不適，請立即摘下耳機並向測驗人員反應。'}" 
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="受測提示：若測驗中感到任何不適，請立即摘下耳機並向測驗人員反應。"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCountdownActive}" Value="True">
                                <Setter Property="Text" Value="準備提示：倒數進行中，請深呼吸戴妥耳機。若已準備完成，可隨時點擊按鈕或按空白鍵直接開始。"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTestCompleted}" Value="True">
                                <Setter Property="Text" Value="測驗已結束：您可以摘下耳機放鬆休息，施測人員即將為您解說檢測數據。"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
